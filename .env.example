# Payment provider configuration — PLACEHOLDER NAMES ONLY.
#
# No real payment provider is integrated yet (see src/lib/payments/README.md
# for the full architecture and the current status of each provider). Do
# NOT put real credentials in this file — it's committed as documentation.
# Real values belong in an untracked .env.local (or your hosting
# provider's secret manager), which .gitignore already excludes.
#
# These are server-side secrets: never read them from client-side code,
# and never rename them with a NEXT_PUBLIC_ prefix (that would bundle the
# value into the browser JS and expose it to every visitor).

# Which provider is currently configured (e.g. "bcel"). Empty = none.
PAYMENT_PROVIDER=

# Provider-issued merchant/account identifier.
PAYMENT_MERCHANT_ID=

# Provider API key — server-side only.
PAYMENT_API_KEY=

# Provider webhook/signing secret, used to verify that a webhook request
# genuinely came from the provider (see src/app/api/payments/webhook) —
# server-side only.
PAYMENT_SECRET=

# ---------------------------------------------------------------------
# Supabase (Step 39) — PLACEHOLDER NAMES ONLY, no real project connected
# by default. See supabase/README.md for the full schema this project is
# designed against.
#
# These two ARE meant to be public (NEXT_PUBLIC_-prefixed, bundled into
# the browser): Row Level Security — not secrecy of this key — is what
# protects data (see supabase/README.md's RLS strategy). Only the product
# catalog's read path is connected as of this step; nothing else.
#
# If a server-only privileged key (e.g. a service-role key for a future
# order-write path) is ever added, it must be a plain, non-`NEXT_PUBLIC_`
# variable, read only from server-only code — never here, never from
# anything a Client Component imports.
# ---------------------------------------------------------------------

# Your Supabase project's URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase project's publishable key (Supabase's current dashboard
# naming — API Settings → Project API keys → "publishable" key, the
# sb_publishable_... key that replaces the legacy "anon" key naming).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# Email provider (Order Email Notification Foundation phase) —
# PLACEHOLDER NAMES ONLY, no real provider connected by default. See
# src/lib/email/README.md for the full architecture and current status.
#
# These are server-side only: never read them from client-side code, and
# never rename them with a NEXT_PUBLIC_ prefix (that would bundle a secret
# into the browser JS and expose it to every visitor). Leaving all of
# these empty (this project's normal state today) makes
# isEmailServiceConfigured() return false — order confirmation emails are
# safely skipped and logged as "not configured," never faked as sent.
# ---------------------------------------------------------------------

# Which provider is currently configured — "resend" or "smtp" (the two
# adapters this project has a prepared, not-yet-implemented interface for;
# see src/lib/email/providers/). Empty = none. Naming a provider here alone
# is NOT enough to make isEmailServiceConfigured() true — that adapter's
# own send() is still a "not implemented" stub until someone implements it
# for real (see that file's own TODO).
EMAIL_PROVIDER=

# The "from" address real emails would be sent from, e.g. orders@yourdomain.com.
EMAIL_FROM=

# Optional "reply-to" address for real customer replies.
EMAIL_REPLY_TO=

# This deployment's real, canonical base URL (no trailing slash), used to
# build absolute "View Order"/"View Invoice" links inside emails — a
# relative path is useless in an inbox. Falls back to
# http://localhost:3000 when unset.
APP_URL=

# --- If EMAIL_PROVIDER=resend (once providers/resendProvider.ts is implemented) ---
# Resend's own API key — server-side only, never NEXT_PUBLIC_-prefixed.
RESEND_API_KEY=

# --- If EMAIL_PROVIDER=smtp (once providers/smtpProvider.ts is implemented) ---
# A standard SMTP relay's connection details — server-side only.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
